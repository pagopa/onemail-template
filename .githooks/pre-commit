#!/usr/bin/env bash
# Purpose: Enforce one client per commit and keep docs/templates-tree.md aligned with templates/.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Check single file
# Check only staged changes
files=()
while IFS= read -r -d '' path; do
    files+=("$path")
done < <(git diff --cached --name-only --no-renames -z -- 'templates/**')

if [[ ${#files[@]} -gt 0 ]]; then
    bash scripts/check-single-client.sh "${files[@]}" > /dev/null
fi

# Check that the templates tree is up to date
bash scripts/generate-template-tree.sh --check-and-update
