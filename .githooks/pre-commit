#!/usr/bin/env bash
# Purpose: Enforce one client per branch and keep docs/templates-tree.md aligned with templates/.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! base=$(git merge-base refs/remotes/origin/main HEAD); then
    printf 'Cannot compare this branch with origin/main. Run git fetch origin main and retry.\n' >&2
    exit 1
fi

files=()
while IFS= read -r -d '' path; do
    files+=("$path")
done < <(git diff --cached --name-only --no-renames -z "$base" -- templates/)

if [[ ${#files[@]} -gt 0 ]]; then
    bash scripts/check-single-client.sh "${files[@]}" > /dev/null
fi

# Check that the templates tree is up to date
bash scripts/generate-template-tree.sh --check-and-update
